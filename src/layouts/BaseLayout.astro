---
import '../styles/main.css';
import State from '../state/index.astro';


const title = 'Mazmorra';
const description = 'Juego de supervivencia en la mazmorra';
const themeColor = '#1a1a2e';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
    <meta name="theme-color" content={themeColor} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%231a1a2e'/%3E%3Crect x='4' y='4' width='24' height='24' rx='2' fill='%234a4a6a'/%3E%3Crect x='8' y='8' width='8' height='8' fill='%234ecdc4'/%3E%3Crect x='18' y='8' width='4' height='4' fill='%23ff6b6b'/%3E%3Crect x='8' y='20' width='16' height='4' fill='%238b6914'/%3E%3C/svg%3E" />
    <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='16' fill='%231a1a2e'/%3E%3Crect x='10' y='10' width='80' height='80' rx='8' fill='%234a4a6a'/%3E%3Crect x='25' y='25' width='25' height='25' fill='%234ecdc4'/%3E%3Crect x='60' y='25' width='15' height='15' fill='%23ff6b6b'/%3E%3Crect x='25' y='65' width='50' height='15' fill='%238b6914'/%3E%3C/svg%3E" />
    <link rel="manifest" href={'data:application/json,' + encodeURIComponent(JSON.stringify({
      name: title,
      short_name: title,
      start_url: '/',
      display: 'standalone',
      background_color: '#0a0a14',
      theme_color: themeColor,
      icons: [{
        src: 'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"%3E%3Crect width="100" height="100" rx="16" fill="%231a1a2e"/%3E%3Crect x="10" y="10" width="80" height="80" rx="8" fill="%234a4a6a"/%3E%3Crect x="25" y="25" width="25" height="25" fill="%234ecdc4"/%3E%3Crect x="60" y="25" width="15" height="15" fill="%23ff6b6b"/%3E%3C/svg%3E',
        sizes: '192x192',
        type: 'image/svg+xml'
      }]
    }))} />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        overscroll-behavior: none;
        -webkit-tap-highlight-color: transparent;
        padding-top: env(safe-area-inset-top);
        padding-bottom: env(safe-area-inset-bottom);
        background: #0a0a14;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <slot />
    <State/>
  </body>
</html>
