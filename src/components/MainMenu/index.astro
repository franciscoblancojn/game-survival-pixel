---
---
<div id="mainmenu-overlay" class="game-overlay mainmenu-overlay">
  <div class="mainmenu-panel">
    <h1 class="mainmenu-title">🗡️ Mazmorra</h1>

    <div id="mainmenu-root" class="mainmenu-screen">
      <button id="mainmenu-new" class="mainmenu-btn primary">Nueva partida</button>
      <button id="mainmenu-continue" class="mainmenu-btn">Continuar</button>
    </div>

    <div id="mainmenu-slots" class="mainmenu-screen" style="display: none;">
      <div class="mainmenu-slots-header">
        <button id="mainmenu-back" class="mainmenu-back" aria-label="Volver">←</button>
        <h2 id="mainmenu-slots-title">Selecciona una partida</h2>
      </div>
      <div id="mainmenu-slots-list" class="mainmenu-slots-list"></div>
    </div>

    <div id="mainmenu-difficulty" class="mainmenu-screen" style="display: none;">
      <div class="mainmenu-slots-header">
        <button id="mainmenu-difficulty-back" class="mainmenu-back" aria-label="Volver">←</button>
        <h2>Elige la dificultad</h2>
      </div>
      <div id="mainmenu-difficulty-list" class="mainmenu-slots-list"></div>
    </div>
  </div>
</div>
