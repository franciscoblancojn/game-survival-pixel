---
---
<div id="market-overlay" class="game-overlay" style="display: none;">
  <div class="market-panel">
    <div class="market-header">
      <div class="market-npc-info">
        <h3 id="market-npc-name">Comerciante</h3>
        <p id="market-npc-desc" class="market-npc-desc"></p>
      </div>
      <div class="market-header-right">
        <span id="market-gold" class="market-gold">💰 0</span>
        <button class="market-close" id="market-close-btn">✕</button>
      </div>
    </div>
    <p id="market-dialogue" class="market-dialogue"></p>
    <div class="market-columns">
      <div class="market-column">
        <h4>Comprar</h4>
        <div id="market-buy-list" class="market-list"></div>
      </div>
      <div class="market-column">
        <h4>Vender</h4>
        <div id="market-sell-list" class="market-list"></div>
      </div>
    </div>
  </div>
</div>
